    "/templates/{template_id}/versions": {
      "post": {
        "tags": [
          "Resume templates"
        ],
        "operationId": "uploadResumeTemplateVersion",
        "summary": "Add a version to a resume template (5 MB max, 20 versions per template; identical bytes are a no-op)",
        "security": [
          {
            "oauth2": [
              "resumes:write"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
