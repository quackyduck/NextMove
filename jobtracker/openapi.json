{
  "openapi": "3.1.0",
  "info": {
    "title": "My Next Moov API",
    "version": "1.0.0",
    "description": "Job search tracker API for people and their agents. Agents connect with OAuth 2.1 (authorization code + PKCE, dynamic client registration at /oauth/register) and only get the scopes the user approves. The same capabilities are available as an MCP server at /mcp. Every request acts as one user; other users' IDs return 404. Edits that carry `version` fail with 409 when the role changed since it was read: re-read and reapply, never retry blindly. Stage changes must reflect work the user actually did."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "oauth2": []
    }
  ],
  "tags": [
    {
      "name": "Roles"
    },
    {
      "name": "Contacts"
    },
    {
      "name": "Resumes"
    },
    {
      "name": "Resume templates",
      "description": "Named master resumes, one per kind of role, each with its own numbered versions. Exactly one is the default: what the /profile/resume routes and agents that name no template use."
    }
  ],
  "paths": {
    "/jobs": {
      "get": {
        "tags": [
          "Roles"
        ],
        "operationId": "listJobs",
        "summary": "List saved roles, most recently updated first",
        "security": [
          {
            "oauth2": [
              "jobs:read"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jobs": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Job"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "tags": [
          "Roles"
        ],
        "operationId": "createJob",
        "summary": "Save a role",
        "description": "Requires a title, URL or description. Does not fetch the URL; use /jobs/extract for that.",
        "security": [
          {
            "oauth2": [
              "jobs:write"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "company": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "found_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "description": {
                    "type": "string"
                  },
                  "location": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "salary": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "lane": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "priority": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  "stage": {
                    "type": "string",
                    "enum": [
                      "needs_review",
                      "interesting",
                      "resume_updated",
                      "outreach",
                      "applied",
                      "recruiter_interview",
                      "hiring_manager_interview",
                      "panel_interview",
                      "offer"
                    ]
                  },
                  "outcome": {
                    "type": "string",
                    "enum": [
                      "active",
                      "rejected",
                      "withdrawn",
                      "closed",
                      "accepted",
                      "not_interested"
                    ]
                  },
                  "outreach_completed": {
                    "type": "boolean"
                  },
                  "notes": {
                    "type": "string"
                  },
                  "next_action": {
                    "type": "string"
                  },
                  "next_action_date": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/jobs/search": {
      "get": {
        "tags": [
          "Roles"
        ],
        "operationId": "searchJobs",
        "summary": "Find saved roles that may duplicate a posting",
        "description": "Matches by company, title and/or URL with explainable reasons. 120 requests per minute per account.",
        "security": [
          {
            "oauth2": [
              "jobs:read"
            ]
          }
        ],
        "parameters": [
          {
            "name": "company",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "title",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "matches": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/jobs/extract": {
      "post": {
        "tags": [
          "Roles"
        ],
        "operationId": "extractPosting",
        "summary": "Read a posting URL in the background (does not save a role)",
        "security": [
          {
            "oauth2": [
              "jobs:write"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted; poll /extractions/{id}",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Extraction"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/extractions/{id}": {
      "get": {
        "tags": [
          "Roles"
        ],
        "operationId": "getExtraction",
        "summary": "Poll a posting extraction",
        "security": [
          {
            "oauth2": [
              "jobs:read"
            ]
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Extraction"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/jobs/{job_id}": {
      "parameters": [
        {
          "name": "job_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "tags": [
          "Roles"
        ],
        "operationId": "getJob",
        "summary": "Read a role",
        "security": [
          {
            "oauth2": [
              "jobs:read"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "patch": {
        "tags": [
          "Roles"
        ],
        "operationId": "updateJob",
        "summary": "Update a role: stage, outcome, notes or other fields",
        "security": [
          {
            "oauth2": [
              "jobs:write"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "company": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "found_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "description": {
                    "type": "string"
                  },
                  "location": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "salary": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "lane": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "priority": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  "stage": {
                    "type": "string",
                    "enum": [
                      "needs_review",
                      "interesting",
                      "resume_updated",
                      "outreach",
                      "applied",
                      "recruiter_interview",
                      "hiring_manager_interview",
                      "panel_interview",
                      "offer"
                    ]
                  },
                  "outcome": {
                    "type": "string",
                    "enum": [
                      "active",
                      "rejected",
                      "withdrawn",
                      "closed",
                      "accepted",
                      "not_interested"
                    ]
                  },
                  "outreach_completed": {
                    "type": "boolean"
                  },
                  "notes": {
                    "type": "string"
                  },
                  "next_action": {
                    "type": "string"
                  },
                  "next_action_date": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date"
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Current version; 409 when stale"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/jobs/{job_id}/activities": {
      "parameters": [
        {
          "name": "job_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "tags": [
          "Roles"
        ],
        "operationId": "listActivities",
        "summary": "Role history",
        "security": [
          {
            "oauth2": [
              "jobs:read"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "activities": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Activity"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/jobs/{job_id}/contacts": {
      "parameters": [
        {
          "name": "job_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "tags": [
          "Contacts"
        ],
        "operationId": "listContacts",
        "summary": "Contacts for a role",
        "security": [
          {
            "oauth2": [
              "jobs:read"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "contacts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Contact"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "tags": [
          "Contacts"
        ],
        "operationId": "createContact",
        "summary": "Add a contact (does not mark outreach)",
        "security": [
          {
            "oauth2": [
              "jobs:write"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Contact"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/jobs/{job_id}/resumes": {
      "parameters": [
        {
          "name": "job_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "tags": [
          "Resumes"
        ],
        "operationId": "listJobResumes",
        "summary": "Resume versions attached to a role",
        "security": [
          {
            "oauth2": [
              "resumes:read"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "resumes": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Resume"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "tags": [
          "Resumes"
        ],
        "operationId": "uploadJobResume",
        "summary": "Attach a new resume version to a role",
        "description": "Not idempotent: each call adds a version. Does not change the role's stage.",
        "security": [
          {
            "oauth2": [
              "resumes:write"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "PDF, DOCX or UTF-8 TXT"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resume"
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/resumes/{id}/download": {
      "get": {
        "tags": [
          "Resumes"
        ],
        "operationId": "downloadJobResume",
        "summary": "Download a role's resume file",
        "security": [
          {
            "oauth2": [
              "resumes:read"
            ]
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The file",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/profile/resume": {
      "get": {
        "tags": [
          "Resumes"
        ],
        "operationId": "getMasterResume",
        "summary": "Latest version and all versions of the default resume template",
        "security": [
          {
            "oauth2": [
              "resumes:read"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "resume": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/MasterResume"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "versions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MasterResume"
                      }
                    },
                    "template": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/ResumeTemplate"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "The default template; null before the first upload"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "tags": [
          "Resumes"
        ],
        "operationId": "uploadMasterResume",
        "summary": "Add a version to the default resume template (5 MB max; identical bytes are a no-op; the first upload creates \"Main resume\")",
        "security": [
          {
            "oauth2": [
              "resumes:write"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "PDF, DOCX or UTF-8 TXT"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "resume": {
                      "$ref": "#/components/schemas/MasterResume"
                    },
                    "created": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "200": {
            "description": "Same as the latest version",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "resume": {
                      "$ref": "#/components/schemas/MasterResume"
                    },
                    "created": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
