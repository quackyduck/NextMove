  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "description": "Authorization code with PKCE (S256). Public clients register at /oauth/register.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "/oauth/authorize",
            "tokenUrl": "/oauth/token",
            "refreshUrl": "/oauth/token",
            "scopes": {
              "jobs:read": "See saved roles, notes, contacts and history",
              "jobs:write": "Add roles, move stages, add notes and contacts",
              "resumes:read": "Read and download resumes",
              "resumes:write": "Upload new resume versions; create, rename or set the default resume template"
            }
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing, expired or revoked token. See WWW-Authenticate.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The token lacks the required scope (error=insufficient_scope).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "maxLength": 500
          },
          "company": {
            "type": "string",
            "maxLength": 500
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "found_date": {
            "type": "string",
            "format": "date"
          },
          "description": {
            "type": "string"
          },
          "location": {
            "type": "string",
            "maxLength": 500
          },
          "salary": {
            "type": "string",
            "maxLength": 500
          },
          "lane": {
            "type": "string",
            "maxLength": 500
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "stage": {
            "type": "string",
            "enum": [
              "needs_review",
              "interesting",
              "resume_updated",
              "outreach",
              "applied",
              "recruiter_interview",
              "hiring_manager_interview",
              "panel_interview",
              "offer"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "active",
              "rejected",
              "withdrawn",
              "closed",
              "accepted",
              "not_interested"
            ]
          },
          "outreach_completed": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          },
          "next_action": {
            "type": "string"
          },
          "next_action_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer"
          }
        }
      },
      "Extraction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "succeeded",
              "failed"
            ]
          },
          "fields": {
            "type": "object"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "error": {
            "type": "string"
          }
        }
      },
      "Activity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "job_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Contact": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "job_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Resume": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "job_id": {
            "type": "string"
          },
          "original_filename": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "sha256": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MasterResume": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "template_id": {
            "type": "string",
            "description": "The resume template this version belongs to; versions are numbered per template"
          },
          "version": {
            "type": "integer"
          },
          "original_filename": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "sha256": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ResumeTemplate": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "description": "Free text, unique per account ignoring case, e.g. \"Engineering manager\""
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "is_default": {
            "type": "boolean",
            "description": "Exactly one template per account is the default"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "version_count": {
            "type": "integer"
          },
          "latest": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/MasterResume"
              },
              {
                "type": "null"
              }
            ]
          },
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MasterResume"
            },
            "description": "Newest first; only when reading or creating one template"
          }
        }
      }
    }
  }
}
