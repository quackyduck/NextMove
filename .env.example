# Local-only configuration. setup.sh creates a random secret in .env when absent.
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret
APP_PASSWORD=local-demo-only
# Optional agent access. Set a long random token before using scripts/agent_example.py.
# AGENT_API_TOKEN=
# Defaults: instance/jobtracker.sqlite3 and instance/resumes.
# DATABASE_URL=sqlite:////absolute/path/jobtracker.sqlite3
# UPLOAD_FOLDER=/absolute/path/resumes
# Production requires APP_ENV=production and APP_PASSWORD_HASH (no plain password).
# TRUST_PROXY=1 only behind one trusted proxy with app port inaccessible publicly.
# Production host allowlist (comma-separated, no schemes or URL paths).
# APP_ALLOWED_HOSTS=tracker.example.com,127.0.0.1
# Persistent workspace-wide login budget; defaults beside UPLOAD_FOLDER.
# LOGIN_THROTTLE_DATABASE=/absolute/private/login-throttle.sqlite3
# For a path deployment, match APP_ROOT_PATH at runtime with the frontend build:
# NEXT_MOVE_BASE_PATH=/nextmove/ npm run build (inside frontend)
# APP_ROOT_PATH=/nextmove

# APP_PASSWORD / APP_PASSWORD_HASH initialize the credential once; later changes use UI or the interactive reset-workspace-password CLI.

# Optional search-only bearer verifier (SHA-256 of a high-entropy random token).
# Disabled when unset; never reuse the broad agent or ingestion token.
# ROLE_SEARCH_TOKEN_SHA256=
