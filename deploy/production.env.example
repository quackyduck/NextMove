# TEMPLATE ONLY: never source this file into a shell or store real secrets in Git.
# No credentials have been generated. Requires private provision after approval.
APP_ENV=production
SECRET_KEY=REQUIRED_APPROVED_RANDOM_SECRET
# Bootstrap only: UI changes persist in the workspace DB and do not rewrite this file.
APP_PASSWORD_HASH=REQUIRED_APPROVED_WERKZEUG_HASH
# Leave agent access disabled for this release.
AGENT_API_TOKEN=
# Unset/empty during direct SSH preview; 1 only behind one HTTPS proxy.
TRUST_PROXY=0
APP_ALLOWED_HOSTS=nicolasmelo.com,127.0.0.1
APP_ROOT_PATH=/nextmove
# Native service paths. No personal local data is migrated.
DATABASE_URL=sqlite:////var/lib/next-move/jobtracker.sqlite3
UPLOAD_FOLDER=/var/lib/next-move/resumes
LOGIN_THROTTLE_DATABASE=/var/lib/next-move/login-throttle.sqlite3
GUNICORN_BIND=127.0.0.1:5001
